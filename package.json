{
  "name": "unified-collaboration-editor",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"cd packages/server && npm run dev\" \"cd packages/client && npm run dev\"",
    "dev:server": "cd packages/server && npm run dev",
    "dev:client": "cd packages/client && npm run dev",
    "build": "cd packages/server && npm run build",
    "typecheck": "cd packages/client && npx tsc --noEmit",
    "lint": "cd packages/client && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
